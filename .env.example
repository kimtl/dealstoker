# Shared local defaults
# Production canonical host is www (Spaceship apex → www 301).
APP_BASE_URL=https://www.dealstoker.com
AMAZON_MARKETPLACE=www.amazon.com
# Production Store ID (set on Railway API): dealstoker01-20
AMAZON_PARTNER_TAG=dealstoker01-20

# Local JDBC form. On Railway, paste the plugin DATABASE_URL
# (postgresql://…) — the API converts it to JDBC automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/dealstoker
DATABASE_USERNAME=dealstoker
DATABASE_PASSWORD=dealstoker

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Long random secret for hashing visitor IPs (e.g. `openssl rand -hex 32`)
IP_HASH_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI recommendation blurbs (API service)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional: stronger model for long-form guide drafts, rewrites and translations
OPENAI_GUIDE_MODEL=

# Web (apps/web/.env.local)
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Railway) — see docs/deploy/railway.md
# APP_BASE_URL=https://www.dealstoker.com
# CORS_ALLOWED_ORIGINS=https://dealstoker.com,https://www.dealstoker.com
# API_BASE_URL=https://api.dealstoker.com
# NEXT_PUBLIC_SITE_URL=https://www.dealstoker.com

# Daily Amazon price refresh (API service)
PRICE_REFRESH_ENABLED=true
PRICE_REFRESH_CRON=0 17 5 * * *
