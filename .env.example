# Shared local defaults
APP_BASE_URL=https://dealstoker.com
AMAZON_MARKETPLACE=www.amazon.com
# Production Store ID (set on Railway API): dealstoker01-20
AMAZON_PARTNER_TAG=

# Local JDBC form. On Railway, paste the plugin DATABASE_URL
# (postgresql://…) — the API converts it to JDBC automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/dealstoker
DATABASE_USERNAME=dealstoker
DATABASE_PASSWORD=dealstoker

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web (apps/web/.env.local)
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Railway) — see docs/deploy/railway.md
# APP_BASE_URL=https://dealstoker.com
# CORS_ALLOWED_ORIGINS=https://dealstoker.com,https://www.dealstoker.com
# API_BASE_URL=https://api.dealstoker.com
# NEXT_PUBLIC_SITE_URL=https://dealstoker.com
